# Export the module function if it exists
[[ $(type -t module) == "function" ]] && export -f module

# Export compute node the script is running on
export host="$(hostname)"

# Hardcode port since the variable is needed but the information isn't.
export port=1234

WORKING_DIR="<%= context.work_dir %>"
if [[ -z "${WORKING_DIR//[[:space:]]/}" ]]; then
  WORKING_DIR="$HOME"
elif [[ "$WORKING_DIR" != /* ]]; then
  WORKING_DIR="$HOME/$WORKING_DIR"
fi
export working_path="$WORKING_DIR"
